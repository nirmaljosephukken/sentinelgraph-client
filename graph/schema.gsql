// =====================================================================================
//  FraudGraph schema - SentinelGraph agentic fraud investigation
//
//  Three layers in one graph:
//    1. Evidence graph   : Customer, Card, Client (latent cardholder), Txn, DeviceProfile,
//                          EmailDomain, BillingRegion
//    2. Case memory      : ClosedCase (bank history), FraudCase (cases this agent opens),
//                          CaseEvent (audit trail), Pattern (typologies)
//    3. Knowledge (RAG)  : PolicyChunk (fraud policy, typologies, regulatory guidance)
//  Graph-local schema (does not clash with other graphs in the workspace).
//  ClosedCase, FraudCase and PolicyChunk carry a 256-d vector attribute `emb` for GraphRAG.
// =====================================================================================

CREATE GRAPH FraudGraph()
USE GRAPH FraudGraph
CREATE SCHEMA_CHANGE JOB build_fraud_schema FOR GRAPH FraudGraph {
  ADD VERTEX Customer (PRIMARY_ID id STRING, n_cards INT) WITH primary_id_as_attribute="true";
  ADD VERTEX Card (PRIMARY_ID id STRING, customer_id STRING, network STRING, card_type STRING, n_txns INT) WITH primary_id_as_attribute="true";
  ADD VERTEX Client (PRIMARY_ID id STRING, card_id STRING, home_region STRING, open_day INT) WITH primary_id_as_attribute="true";
  ADD VERTEX Txn (PRIMARY_ID id STRING, ts DATETIME, amount DOUBLE, product STRING, channel STRING,
                     risk_score DOUBLE, model_score DOUBLE, addr1 STRING, addr2 STRING, dist1 DOUBLE,
                     p_email STRING, r_email STRING, device_status STRING, proxy_type STRING,
                     device_profile STRING, device_type STRING, m4 STRING, m6 STRING, d1 DOUBLE,
                     card_id STRING, customer_id STRING, client_id STRING) WITH primary_id_as_attribute="true";
  ADD VERTEX DeviceProfile (PRIMARY_ID id STRING, device_type STRING, n_txns INT) WITH primary_id_as_attribute="true";
  ADD VERTEX EmailDomain (PRIMARY_ID id STRING) WITH primary_id_as_attribute="true";
  ADD VERTEX BillingRegion (PRIMARY_ID id STRING) WITH primary_id_as_attribute="true";
  ADD VERTEX Pattern (PRIMARY_ID id STRING, description STRING) WITH primary_id_as_attribute="true";
  ADD VERTEX ClosedCase (PRIMARY_ID id STRING, customer_id STRING, card_id STRING, opened_at DATETIME,
                            closed_at DATETIME, outcome STRING, pattern STRING, n_txns INT, exposure_usd DOUBLE,
                            actions_taken STRING, report_filed STRING, analyst_notes STRING,
                            txn_ids STRING, connected_card_ids STRING, first_fraud_txn_id STRING) WITH primary_id_as_attribute="true";
  ADD VERTEX FraudCase (PRIMARY_ID id STRING, source_case_id STRING, trigger_type STRING, opened_at DATETIME,
                           updated_at DATETIME, status STRING, verdict STRING, fraud_probability DOUBLE,
                           pattern STRING, exposure_usd DOUBLE, summary STRING, sar_filed BOOL,
                           final_actions STRING, answer_json STRING) WITH primary_id_as_attribute="true";
  ADD VERTEX CaseEvent (PRIMARY_ID id STRING, case_id STRING, step INT, ts DATETIME, kind STRING,
                           title STRING, detail STRING) WITH primary_id_as_attribute="true";
  ADD VERTEX PolicyChunk (PRIMARY_ID id STRING, doc STRING, section STRING, text STRING) WITH primary_id_as_attribute="true";
  // ---- evidence graph edges ----
  ADD UNDIRECTED EDGE HAS_CARD (FROM Customer, TO Card);
  ADD UNDIRECTED EDGE CARD_TXN (FROM Card, TO Txn);
  ADD UNDIRECTED EDGE CLIENT_CARD (FROM Client, TO Card);
  ADD UNDIRECTED EDGE CLIENT_TXN (FROM Client, TO Txn);
  ADD UNDIRECTED EDGE TXN_DEVICE (FROM Txn, TO DeviceProfile);
  ADD UNDIRECTED EDGE TXN_P_EMAIL (FROM Txn, TO EmailDomain);
  ADD UNDIRECTED EDGE TXN_R_EMAIL (FROM Txn, TO EmailDomain);
  ADD UNDIRECTED EDGE TXN_REGION (FROM Txn, TO BillingRegion);
  ADD DIRECTED EDGE NEXT_TXN (FROM Txn, TO Txn, gap_s INT);
  // ---- case memory edges ----
  ADD UNDIRECTED EDGE CC_TXN (FROM ClosedCase, TO Txn);
  ADD UNDIRECTED EDGE CC_CARD (FROM ClosedCase, TO Card);
  ADD UNDIRECTED EDGE CC_CONNECTED_CARD (FROM ClosedCase, TO Card);
  ADD UNDIRECTED EDGE CC_PATTERN (FROM ClosedCase, TO Pattern);
  ADD UNDIRECTED EDGE FC_TXN (FROM FraudCase, TO Txn, role STRING);
  ADD UNDIRECTED EDGE FC_CARD (FROM FraudCase, TO Card, role STRING);
  ADD UNDIRECTED EDGE FC_DEVICE (FROM FraudCase, TO DeviceProfile);
  ADD UNDIRECTED EDGE FC_PATTERN (FROM FraudCase, TO Pattern);
  ADD UNDIRECTED EDGE FC_SIMILAR_CC (FROM FraudCase, TO ClosedCase, score DOUBLE);
  ADD UNDIRECTED EDGE FC_SIMILAR_FC (FROM FraudCase, TO FraudCase, score DOUBLE);
  ADD UNDIRECTED EDGE FC_EVENT (FROM FraudCase, TO CaseEvent);
}
RUN SCHEMA_CHANGE JOB build_fraud_schema
DROP JOB build_fraud_schema
