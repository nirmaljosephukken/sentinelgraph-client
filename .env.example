# ---- TigerGraph Savanna (or Community Edition: TG_HOST=http://localhost:14240)
TG_HOST=https://<your-workspace>.i.tgcloud.io
TG_SECRET=<gsql secret created in Savanna>
TG_GRAPH=FraudGraph
# optional: TG_USERNAME / TG_PASSWORD instead of a secret

# ---- LLM (any one). The agent runs without an LLM too (deterministic templates).
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash
# ANTHROPIC_API_KEY=
# LLM_PROVIDER=gemini|anthropic|none

# ---- or Gemini on Vertex AI (what Cloud Run uses; needs `gcloud auth application-default login` locally)
# GOOGLE_GENAI_USE_VERTEXAI=TRUE
# GOOGLE_CLOUD_PROJECT=<your-gcp-project>
# GOOGLE_CLOUD_LOCATION=global

# ---- options
# GRAPH_BACKEND=tigergraph|local      (local = pandas mirror of the GSQL queries, offline dev)
# USE_TG_MCP=true                      (route graph queries through the TigerGraph MCP server)
# TG_MCP_TRUST_ENV=1                   (only behind an HTTPS proxy: lets the MCP server use HTTPS_PROXY)
# LLM_MAX_TOOL_CALLS=4

# ---- Sign-in and roles (client edition). See docs/production.md, "Sign-in".
# AUTH_MODE=oidc|iap|dev              (deploy.ps1 sets oidc when the three lines below are filled in)
# AUTH_CLIENT_ID=<OAuth web client id>.apps.googleusercontent.com
# AUTH_CLIENT_SECRET=<OAuth web client secret>
# ADMIN_EMAILS=you@yourbank.com;second.admin@yourbank.com
# DEFAULT_ROLE=viewer                  (role given to anyone else on first sign-in)
# AUTH_METADATA_URL=                   (other identity providers: Okta, Entra ID, Auth0 discovery URL)
# IAP_AUDIENCE=/projects/<number>/global/backendServices/<id>   (only with AUTH_MODE=iap)

# ---- Assist mode: where approved and automatic actions are sent (docs/production.md, "Operating modes")
# ACTION_WEBHOOK_URL=https://cards.yourbank.internal/sentinelgraph/actions
# ACTION_WEBHOOK_SECRET=<long random string shared with the receiving system>
