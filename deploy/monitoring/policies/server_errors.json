{
 "displayName": "SentinelGraph {{SERVICE}}: server errors",
 "severity": "ERROR",
 "combiner": "OR",
 "conditions": [
  {
   "displayName": "5xx responses > 5 in 5 min",
   "conditionThreshold": {
    "filter": "metric.type=\"run.googleapis.com/request_count\" AND resource.type=\"cloud_run_revision\" AND resource.label.service_name=monitoring.regex.full_match(\"{{SERVICE}}(-worker|-api)?\") AND metric.label.response_code_class=\"5xx\"",
    "aggregations": [
     {
      "alignmentPeriod": "300s",
      "perSeriesAligner": "ALIGN_SUM",
      "crossSeriesReducer": "REDUCE_SUM"
     }
    ],
    "comparison": "COMPARISON_GT",
    "thresholdValue": 5,
    "duration": "0s",
    "trigger": {
     "count": 1
    }
   }
  }
 ],
 "alertStrategy": {
  "autoClose": "1800s"
 },
 "documentation": {
  "mimeType": "text/markdown",
  "content": "One of the services is returning server errors. Cloud Run > the service > Logs, filter severity>=ERROR."
 },
 "notificationChannels": [
  "{{CHANNEL}}"
 ],
 "userLabels": {
  "app": "sentinelgraph",
  "check": "server-errors"
 }
}