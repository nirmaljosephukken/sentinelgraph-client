{
 "name": "{{PREFIX}}_audit_events",
 "description": "Audit-log entries by action",
 "filter": "resource.type=\"cloud_run_revision\" AND resource.labels.service_name:\"{{SERVICE}}\" AND jsonPayload.event=\"audit\"",
 "labelExtractors": {
  "action": "EXTRACT(jsonPayload.action)"
 },
 "metricDescriptor": {
  "metricKind": "DELTA",
  "valueType": "INT64",
  "labels": [
   {
    "key": "action",
    "valueType": "STRING"
   }
  ]
 }
}