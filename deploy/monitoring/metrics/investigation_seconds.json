{
 "name": "{{PREFIX}}_investigation_seconds",
 "description": "Time to investigate one alert",
 "filter": "resource.type=\"cloud_run_revision\" AND resource.labels.service_name:\"{{SERVICE}}\" AND jsonPayload.event=\"investigation_done\"",
 "valueExtractor": "EXTRACT(jsonPayload.seconds)",
 "metricDescriptor": {
  "metricKind": "DELTA",
  "valueType": "DISTRIBUTION",
  "unit": "s"
 },
 "bucketOptions": {
  "exponentialBuckets": {
   "numFiniteBuckets": 20,
   "growthFactor": 1.5,
   "scale": 0.5
  }
 }
}