{
 "displayName": "SentinelGraph {{SERVICE}}",
 "mosaicLayout": {
  "columns": 12,
  "tiles": [
   {
    "xPos": 0,
    "yPos": 0,
    "width": 6,
    "height": 4,
    "widget": {
     "title": "Investigations per 5 min",
     "xyChart": {
      "dataSets": [
       {
        "timeSeriesQuery": {
         "timeSeriesFilter": {
          "filter": "metric.type=\"logging.googleapis.com/user/{{PREFIX}}_investigations\" AND resource.type=\"cloud_run_revision\"",
          "aggregation": {
           "alignmentPeriod": "300s",
           "perSeriesAligner": "ALIGN_SUM",
           "crossSeriesReducer": "REDUCE_SUM"
          }
         }
        },
        "plotType": "STACKED_BAR"
       }
      ],
      "yAxis": {
       "scale": "LINEAR"
      }
     }
    }
   },
   {
    "xPos": 6,
    "yPos": 0,
    "width": 6,
    "height": 4,
    "widget": {
     "title": "Investigation time p95 (s)",
     "xyChart": {
      "dataSets": [
       {
        "timeSeriesQuery": {
         "timeSeriesFilter": {
          "filter": "metric.type=\"logging.googleapis.com/user/{{PREFIX}}_investigation_seconds\" AND resource.type=\"cloud_run_revision\"",
          "aggregation": {
           "alignmentPeriod": "300s",
           "perSeriesAligner": "ALIGN_DELTA",
           "crossSeriesReducer": "REDUCE_PERCENTILE_95"
          }
         }
        },
        "plotType": "LINE"
       }
      ],
      "yAxis": {
       "scale": "LINEAR"
      }
     }
    }
   },
   {
    "xPos": 0,
    "yPos": 4,
    "width": 6,
    "height": 4,
    "widget": {
     "title": "Audit events by action",
     "xyChart": {
      "dataSets": [
       {
        "timeSeriesQuery": {
         "timeSeriesFilter": {
          "filter": "metric.type=\"logging.googleapis.com/user/{{PREFIX}}_audit_events\" AND resource.type=\"cloud_run_revision\"",
          "aggregation": {
           "alignmentPeriod": "300s",
           "perSeriesAligner": "ALIGN_SUM",
           "crossSeriesReducer": "REDUCE_SUM",
           "groupByFields": [
            "metric.label.action"
           ]
          }
         }
        },
        "plotType": "STACKED_BAR"
       }
      ],
      "yAxis": {
       "scale": "LINEAR"
      }
     }
    }
   },
   {
    "xPos": 6,
    "yPos": 4,
    "width": 6,
    "height": 4,
    "widget": {
     "title": "Errors: investigations, deliveries, Gemini",
     "xyChart": {
      "dataSets": [
       {
        "timeSeriesQuery": {
         "timeSeriesFilter": {
          "filter": "metric.type=\"logging.googleapis.com/user/{{PREFIX}}_investigation_errors\" AND resource.type=\"cloud_run_revision\"",
          "aggregation": {
           "alignmentPeriod": "300s",
           "perSeriesAligner": "ALIGN_SUM",
           "crossSeriesReducer": "REDUCE_SUM"
          }
         }
        },
        "plotType": "LINE"
       },
       {
        "timeSeriesQuery": {
         "timeSeriesFilter": {
          "filter": "metric.type=\"logging.googleapis.com/user/{{PREFIX}}_action_send_failed\" AND resource.type=\"cloud_run_revision\"",
          "aggregation": {
           "alignmentPeriod": "300s",
           "perSeriesAligner": "ALIGN_SUM",
           "crossSeriesReducer": "REDUCE_SUM"
          }
         }
        },
        "plotType": "LINE"
       },
       {
        "timeSeriesQuery": {
         "timeSeriesFilter": {
          "filter": "metric.type=\"logging.googleapis.com/user/{{PREFIX}}_llm_errors\" AND resource.type=\"cloud_run_revision\"",
          "aggregation": {
           "alignmentPeriod": "300s",
           "perSeriesAligner": "ALIGN_SUM",
           "crossSeriesReducer": "REDUCE_SUM"
          }
         }
        },
        "plotType": "LINE"
       }
      ],
      "yAxis": {
       "scale": "LINEAR"
      }
     }
    }
   },
   {
    "xPos": 0,
    "yPos": 8,
    "width": 6,
    "height": 4,
    "widget": {
     "title": "Flagged inputs",
     "xyChart": {
      "dataSets": [
       {
        "timeSeriesQuery": {
         "timeSeriesFilter": {
          "filter": "metric.type=\"logging.googleapis.com/user/{{PREFIX}}_input_flagged\" AND resource.type=\"cloud_run_revision\"",
          "aggregation": {
           "alignmentPeriod": "300s",
           "perSeriesAligner": "ALIGN_SUM",
           "crossSeriesReducer": "REDUCE_SUM"
          }
         }
        },
        "plotType": "STACKED_BAR"
       }
      ],
      "yAxis": {
       "scale": "LINEAR"
      }
     }
    }
   },
   {
    "xPos": 6,
    "yPos": 8,
    "width": 6,
    "height": 4,
    "widget": {
     "title": "Actions not delivered",
     "xyChart": {
      "dataSets": [
       {
        "timeSeriesQuery": {
         "timeSeriesFilter": {
          "filter": "metric.type=\"logging.googleapis.com/user/{{PREFIX}}_action_send_failed\" AND resource.type=\"cloud_run_revision\"",
          "aggregation": {
           "alignmentPeriod": "300s",
           "perSeriesAligner": "ALIGN_SUM",
           "crossSeriesReducer": "REDUCE_SUM"
          }
         }
        },
        "plotType": "STACKED_BAR"
       }
      ],
      "yAxis": {
       "scale": "LINEAR"
      }
     }
    }
   },
   {
    "xPos": 0,
    "yPos": 12,
    "width": 6,
    "height": 4,
    "widget": {
     "title": "Oldest alert waiting on the stream (s)",
     "xyChart": {
      "dataSets": [
       {
        "timeSeriesQuery": {
         "timeSeriesFilter": {
          "filter": "metric.type=\"pubsub.googleapis.com/subscription/oldest_unacked_message_age\" AND resource.type=\"pubsub_subscription\" AND resource.label.subscription_id=\"{{SUBSCRIPTION}}\"",
          "aggregation": {
           "alignmentPeriod": "60s",
           "perSeriesAligner": "ALIGN_MAX",
           "crossSeriesReducer": "REDUCE_MAX"
          }
         }
        },
        "plotType": "LINE"
       }
      ],
      "yAxis": {
       "scale": "LINEAR"
      }
     }
    }
   },
   {
    "xPos": 6,
    "yPos": 12,
    "width": 6,
    "height": 4,
    "widget": {
     "title": "Requests by service and status",
     "xyChart": {
      "dataSets": [
       {
        "timeSeriesQuery": {
         "timeSeriesFilter": {
          "filter": "metric.type=\"run.googleapis.com/request_count\" AND resource.type=\"cloud_run_revision\" AND resource.label.service_name=monitoring.regex.full_match(\"{{SERVICE}}(-worker|-api)?\")",
          "aggregation": {
           "alignmentPeriod": "300s",
           "perSeriesAligner": "ALIGN_SUM",
           "crossSeriesReducer": "REDUCE_SUM",
           "groupByFields": [
            "resource.label.service_name",
            "metric.label.response_code_class"
           ]
          }
         }
        },
        "plotType": "STACKED_BAR"
       }
      ],
      "yAxis": {
       "scale": "LINEAR"
      }
     }
    }
   }
  ]
 }
}